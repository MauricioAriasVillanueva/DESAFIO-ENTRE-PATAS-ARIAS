Funcion valido <- SoloDigitos(texto)
    Definir i Como Entero
    Definir caracter Como Cadena
	
    valido <- Verdadero
	
    Si Longitud(texto) = 0 Entonces
        valido <- Falso
    SiNo
        Para i <- 1 Hasta Longitud(texto) Hacer
            caracter <- Subcadena(texto, i, i)
			
            Si caracter < "0" O caracter > "9" Entonces
                valido <- Falso
            FinSi
        FinPara
    FinSi
FinFuncion

Funcion valido <- FechaCalendarioValida(fecha)
    Definir dia, mes, anio, diasMes Como Entero
    Definir cifras Como Cadena
	
    valido <- Falso
	
    Si Longitud(fecha) = 10 Entonces
        Si Subcadena(fecha, 3, 3) = "/" Y Subcadena(fecha, 6, 6) = "/" Entonces
			
            cifras <- Concatenar(Subcadena(fecha, 1, 2), Subcadena(fecha, 4, 5))
            cifras <- Concatenar(cifras, Subcadena(fecha, 7, 10))
			
            Si SoloDigitos(cifras) Entonces
                dia <- ConvertirANumero(Subcadena(fecha, 1, 2))
                mes <- ConvertirANumero(Subcadena(fecha, 4, 5))
                anio <- ConvertirANumero(Subcadena(fecha, 7, 10))
				
                Si anio >= 1 Y mes >= 1 Y mes <= 12 Y dia >= 1 Entonces
					
                    Segun mes Hacer
                        1, 3, 5, 7, 8, 10, 12:
                            diasMes <- 31
                        4, 6, 9, 11:
                            diasMes <- 30
                        2:
                            diasMes <- 28
							
                            Si anio MOD 400 = 0 O (anio MOD 4 = 0 Y anio MOD 100 <> 0) Entonces
                                diasMes <- 29
                            FinSi
                    FinSegun
					
                    Si dia <= diasMes Entonces
                        valido <- Verdadero
                    FinSi
                FinSi
            FinSi
        FinSi
    FinSi
FinFuncion

SubProceso Registrar(mascotas Por Referencia, propietarios Por Referencia, telefonos Por Referencia, especies Por Referencia, codigosMascotas Por Referencia, codigosPropietarios Por Referencia, tiposAnimales Por Referencia, sexos Por Referencia, fechasNacimiento Por Referencia, cantidad Por Referencia, codigoPropietario Por Referencia, codigoMascota Por Referencia, fechaReferencia)
	
    Definir nombrePropietario, telefono, nombreMascota Como Cadena
    Definir tipoAnimal, especie, sexo, fechaNacimiento Como Cadena
    Definir valido Como Logico
    Definir dia, mes, anio, diaRef, mesRef, anioRef Como Entero
	
    Si cantidad >= 100 Entonces
        Escribir "Limite de 100 registros alcanzado."
    SiNo
        Escribir "=== REGISTRAR PROPIETARIO Y MASCOTA ==="
		
        Repetir
            Escribir "Nombre del propietario:"
            Leer nombrePropietario
			
            Si Longitud(nombrePropietario) = 0 Entonces
                Escribir "Error: el nombre no puede estar vacio."
            FinSi
        Hasta Que Longitud(nombrePropietario) > 0
		
        Repetir
            Escribir "Telefono del propietario (9 digitos):"
            Leer telefono
			
            valido <- Longitud(telefono) = 9
			
            Si valido Entonces
                valido <- SoloDigitos(telefono)
            FinSi
			
            Si NO valido Entonces
                Escribir "Error: el telefono debe contener 9 digitos numericos."
            FinSi
        Hasta Que valido
		
        Repetir
            Escribir "Nombre de la mascota:"
            Leer nombreMascota
			
            Si Longitud(nombreMascota) = 0 Entonces
                Escribir "Error: ingrese el nombre de la mascota."
            FinSi
        Hasta Que Longitud(nombreMascota) > 0
		
        Repetir
            Escribir "Tipo (Canino/Felino):"
            Leer tipoAnimal
			
            tipoAnimal <- Mayusculas(tipoAnimal)
            valido <- tipoAnimal = "CANINO" O tipoAnimal = "FELINO"
			
            Si NO valido Entonces
                Escribir "Error: solo se permite Canino o Felino."
            FinSi
        Hasta Que valido
		
        Si tipoAnimal = "CANINO" Entonces
            tipoAnimal <- "Canino"
        SiNo
            tipoAnimal <- "Felino"
        FinSi
		
        Repetir
            Escribir "Especie o raza:"
            Leer especie
			
            Si Longitud(especie) = 0 Entonces
                Escribir "Error: ingrese la especie o raza."
            FinSi
        Hasta Que Longitud(especie) > 0
		
        Repetir
            Escribir "Sexo (Macho/Hembra):"
            Leer sexo
			
            sexo <- Mayusculas(sexo)
            valido <- sexo = "MACHO" O sexo = "HEMBRA"
			
            Si NO valido Entonces
                Escribir "Error: solo se permite Macho o Hembra."
            FinSi
        Hasta Que valido
		
        Si sexo = "MACHO" Entonces
            sexo <- "Macho"
        SiNo
            sexo <- "Hembra"
        FinSi
		
        diaRef <- ConvertirANumero(Subcadena(fechaReferencia, 1, 2))
        mesRef <- ConvertirANumero(Subcadena(fechaReferencia, 4, 5))
        anioRef <- ConvertirANumero(Subcadena(fechaReferencia, 7, 10))
		
        Repetir
            Escribir "Fecha de nacimiento (DD/MM/AAAA):"
            Leer fechaNacimiento
			
            valido <- FechaCalendarioValida(fechaNacimiento)
			
            Si valido Entonces
                dia <- ConvertirANumero(Subcadena(fechaNacimiento, 1, 2))
                mes <- ConvertirANumero(Subcadena(fechaNacimiento, 4, 5))
                anio <- ConvertirANumero(Subcadena(fechaNacimiento, 7, 10))
				
                Si anio > anioRef O (anio = anioRef Y mes > mesRef) O (anio = anioRef Y mes = mesRef Y dia > diaRef) Entonces
                    valido <- Falso
                FinSi
            FinSi
			
            Si NO valido Entonces
                Escribir "Error: fecha invalida o posterior a la fecha de referencia."
            FinSi
        Hasta Que valido
		
        cantidad <- cantidad + 1
		
        codigosPropietarios[cantidad] <- codigoPropietario
        propietarios[cantidad] <- nombrePropietario
        telefonos[cantidad] <- telefono
		
        codigosMascotas[cantidad] <- codigoMascota
        mascotas[cantidad] <- nombreMascota
        tiposAnimales[cantidad] <- tipoAnimal
        especies[cantidad] <- especie
        sexos[cantidad] <- sexo
        fechasNacimiento[cantidad] <- fechaNacimiento
		
        Escribir "Registro guardado correctamente."
        Escribir "Codigo propietario: ", codigoPropietario
        Escribir "Codigo mascota: ", codigoMascota
        Escribir "Cantidad registrada: ", cantidad
		
        codigoPropietario <- codigoPropietario + 1
        codigoMascota <- codigoMascota + 1
    FinSi
FinSubProceso


Algoritmo PruebaRegistro
	
    Definir mascotas, propietarios, telefonos, especies Como Cadena
    Definir tiposAnimales, sexos, fechasNacimiento Como Cadena
    Definir codigosMascotas, codigosPropietarios Como Entero
    Definir cantidad, codigoPropietario, codigoMascota, i Como Entero
    Definir fechaReferencia, continuar Como Cadena
	
    Dimension mascotas[101]
    Dimension propietarios[101]
    Dimension telefonos[101]
    Dimension especies[101]
    Dimension codigosMascotas[101]
    Dimension codigosPropietarios[101]
    Dimension tiposAnimales[101]
    Dimension sexos[101]
    Dimension fechasNacimiento[101]
	
    cantidad <- 0
    codigoPropietario <- 2001
    codigoMascota <- 1001
	
    Repetir
        Escribir "Introduzca la fecha de hoy (DD/MM/AAAA):"
        Leer fechaReferencia
		
        Si NO FechaCalendarioValida(fechaReferencia) Entonces
            Escribir "Error: fecha de referencia invalida."
        FinSi
    Hasta Que FechaCalendarioValida(fechaReferencia)
	
    Repetir
        Registrar(mascotas, propietarios, telefonos, especies, codigosMascotas, codigosPropietarios, tiposAnimales, sexos, fechasNacimiento, cantidad, codigoPropietario, codigoMascota, fechaReferencia)
		
        Escribir "Desea registrar otra mascota? (S/N):"
        Leer continuar
        continuar <- Mayusculas(continuar)
		
    Hasta Que continuar = "N"
	
    Escribir "=== RESUMEN DE REGISTROS ==="
	
    Para i <- 1 Hasta cantidad Hacer
        Escribir "Mascota: ", mascotas[i], " / Propietario: ", propietarios[i], " / Codigo: ", codigosMascotas[i]
    FinPara
	
    Escribir "Total de registros: ", cantidad
	
FinAlgoritmo




