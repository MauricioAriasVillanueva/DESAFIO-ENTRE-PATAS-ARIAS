SubProceso Registrar(mascotas Por Referencia, propietarios Por Referencia, telefonos Por Referencia, especies Por Referencia, codigosMascotas Por Referencia, codigosPropietarios Por Referencia, tiposAnimales Por Referencia, sexos Por Referencia, fechasNacimiento Por Referencia, cantidad Por Referencia, codigoPropietario Por Referencia, codigoMascota Por Referencia)
		Definir nombrePropietario, telefono Como Cadena
		Definir nombreMascota, tipoAnimal, especie Como Cadena
		Definir sexo, fechaNacimiento Como Cadena
		
		Escribir "Nombre del propietario:"
		Leer nombrePropietario
		Escribir "Telefono:"
		Leer telefono
		Escribir "Nombre de la mascota:"
		Leer nombreMascota
		Escribir "Tipo de animal:"
		Leer tipoAnimal
		Escribir "Especie o raza:"
		Leer especie
		Escribir "Sexo:"
		Leer sexo
		Escribir "Fecha de nacimiento:"
		Leer fechaNacimiento
		
		cantidad <- cantidad + 1
		
		codigosPropietarios[cantidad] <- codigoPropietario
		propietarios[cantidad] <- nombrePropietario
		telefonos[cantidad] <- telefono
		codigosMascotas[cantidad] <- codigoMascota
		mascotas[cantidad] <- nombreMascota
		tiposAnimales[cantidad] <- tipoAnimal
		especies[cantidad] <- especie
		sexos[cantidad] <- sexo
		fechasNacimiento[cantidad] <- fechaNacimiento
		
		codigoPropietario <- codigoPropietario + 1
		codigoMascota <- codigoMascota + 1
		
		Escribir "Registro guardado correctamente."
FinSubProceso

Algoritmo PruebaRegistro
    Definir mascotas, propietarios, telefonos, especies Como Cadena
    Definir tiposAnimales, sexos, fechasNacimiento Como Cadena
    Definir codigosMascotas, codigosPropietarios Como Entero
    Definir cantidad, codigoPropietario, codigoMascota Como Entero
	
    Dimension mascotas[100]
    Dimension propietarios[100]
    Dimension telefonos[100]
    Dimension especies[100]
    Dimension codigosMascotas[100]
    Dimension codigosPropietarios[100]
    Dimension tiposAnimales[100]
    Dimension sexos[100]
    Dimension fechasNacimiento[100]
	
    cantidad <- 0
    codigoPropietario <- 2001
    codigoMascota <- 1001
	
    Registrar(mascotas, propietarios, telefonos, especies, codigosMascotas, codigosPropietarios, tiposAnimales, sexos, fechasNacimiento, cantidad, codigoPropietario, codigoMascota)
	
    Escribir "Cantidad registrada: ", cantidad
    Escribir "Mascota guardada: ", mascotas[1]
FinAlgoritmo


